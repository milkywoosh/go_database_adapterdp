            "post": {
                "description": "Create a new Purchase for detail",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "purchase"
                ],
                "summary": "Create a new Purchase",
                "parameters": [
                    {
                        "type": "integer",
